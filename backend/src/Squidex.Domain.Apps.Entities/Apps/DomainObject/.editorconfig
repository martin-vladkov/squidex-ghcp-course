# Squidex — DomainObject path: stricter static-analysis rules
# Inherits from backend/.editorconfig (root = false is default; no root override here).
# These overrides are intentionally stricter than the project-wide defaults so that
# every new file added to this directory is held to a higher standard.
#
# CI enforcement: .github/workflows/ghcp-walk-staticanalysis.yml builds
# Squidex.Domain.Apps.Entities.csproj and fails on any error-severity diagnostic.
# Suppressions in source must include a justification comment (see AppDomainObject.cs).

[*.cs]

# MA0040: Forward the CancellationToken parameter to methods that take one.
# Promoted from 'none' (project-wide default) to 'error' for this directory.
# Rationale: every async method in the DomainObject layer receives a CancellationToken
# from the command dispatcher; callee methods should propagate it so the operation
# can be cancelled promptly. New code that intentionally passes 'default' instead of
# the available ct must add a #pragma warning disable MA0040 with a comment explaining
# why the ambient token must not be forwarded (e.g., the call must complete even after
# the caller cancels — see the billing calls in AppDomainObject.cs).
dotnet_diagnostic.MA0040.severity = error

# MA0007: Add a trailing comma after the last value in multi-line initializers.
# Promoted from 'warning' (project-wide default) to 'error' for this directory.
# Rationale: trailing commas in multi-line lists produce cleaner diffs (no comma
# added to the previous line when a new entry is appended) and are already the
# project's stylistic preference.
dotnet_diagnostic.MA0007.severity = error
